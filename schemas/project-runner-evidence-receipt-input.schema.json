{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-hostess/schemas/project-runner-evidence-receipt-input.schema.json",
  "title": "Hostess binding for canonical Quest generic-media evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "profile_id", "profile_sha256", "project_id", "project_revision",
    "project_spec_sha256", "product_id", "product_lock_id", "product_lock_revision",
    "product_lock_fingerprint", "product_lock_sha256", "authority_revision",
    "issued_at_utc", "expires_at_utc", "evidence_tier", "fatal_count",
    "observations", "owner_receipt_ref"
  ],
  "properties": {
    "$schema": { "const": "rusty.hostess.project_runner.evidence_receipt_binding.v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "profile_sha256": { "$ref": "#/$defs/sha" },
    "project_id": { "$ref": "#/$defs/id" },
    "project_revision": { "type": "integer", "minimum": 1 },
    "project_spec_sha256": { "$ref": "#/$defs/sha" },
    "product_id": { "$ref": "#/$defs/id" },
    "product_lock_id": { "$ref": "#/$defs/id" },
    "product_lock_revision": { "type": "integer", "minimum": 1 },
    "product_lock_fingerprint": { "type": "string", "pattern": "^fnv1a64-[0-9a-f]{16}$" },
    "product_lock_sha256": { "$ref": "#/$defs/sha" },
    "authority_revision": { "type": "integer", "minimum": 1 },
    "issued_at_utc": { "type": "string", "minLength": 1 },
    "expires_at_utc": { "type": "string", "minLength": 1 },
    "evidence_tier": { "enum": ["quick", "standard", "deep", "device", "release"] },
    "fatal_count": { "const": 0 },
    "observations": {
      "type": "object", "additionalProperties": { "type": "boolean" },
      "required": ["bounded_exchange", "inactive_cleanup", "package_cleanup", "zero_fatals"],
      "properties": {
        "bounded_exchange": { "type": "boolean" },
        "inactive_cleanup": { "type": "boolean" },
        "package_cleanup": { "type": "boolean" },
        "zero_fatals": { "type": "boolean" },
        "damaged_fixtures_rejected": { "type": "boolean" },
        "ownership_audit_passed": { "type": "boolean" },
        "device_validation_passed": { "type": "boolean" },
        "device_cleanup_complete": { "type": "boolean" },
        "release_checks_passed": { "type": "boolean" }
      }
    },
    "owner_receipt_ref": { "$ref": "#/$defs/owner_ref" },
    "device_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["device_count", "serials_redacted", "validation_passed", "cleanup_complete", "packages_removed", "zero_fatals"],
      "properties": {
        "device_count": { "type": "integer", "minimum": 1 },
        "serials_redacted": { "type": "boolean" },
        "validation_passed": { "type": "boolean" },
        "cleanup_complete": { "type": "boolean" },
        "packages_removed": { "type": "boolean" },
        "zero_fatals": { "type": "boolean" }
      }
    },
    "release_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_checks_passed", "owner_checks_passed", "device_checks_passed", "cleanup_complete", "zero_fatals", "owner_release_receipts"],
      "properties": {
        "source_checks_passed": { "type": "boolean" },
        "owner_checks_passed": { "type": "boolean" },
        "device_checks_passed": { "type": "boolean" },
        "cleanup_complete": { "type": "boolean" },
        "zero_fatals": { "type": "boolean" },
        "owner_release_receipts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "owner_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "schema", "owner"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" },
        "schema": { "const": "rusty.quest.generic_media_session_evidence.v1" },
        "owner": { "const": "rusty.quest" }
      }
    }
  }
}
