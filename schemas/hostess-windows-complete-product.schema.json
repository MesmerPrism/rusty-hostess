{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-hostess/schemas/hostess-windows-complete-product.schema.json",
  "type": "object",
  "required": ["schema", "product", "channel", "prerelease", "version", "release_tag", "source", "features", "authority_exclusions", "files"],
  "properties": {
    "schema": {"const": "rusty.hostess.windows_complete_product.v1"},
    "product": {"const": "rusty-hostess-alpha"},
    "channel": {"const": "alpha"},
    "prerelease": {"const": true},
    "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "release_tag": {"pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[1-9][0-9]*$"},
    "source": {
      "type": "object",
      "required": ["repository", "revision", "tree", "license"],
      "properties": {
        "repository": {"const": "https://github.com/MesmerPrism/rusty-hostess"},
        "revision": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"},
        "license": {"const": "AGPL-3.0-or-later"}
      },
      "additionalProperties": false
    },
    "features": {"type": "array", "contains": {"const": "meta-cinematic-cast-opaque-adapter"}},
    "authority_exclusions": {"type": "array", "minItems": 6, "uniqueItems": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$"},
          "sha256": {"pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
