{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-hostess/schemas/project-runner-media-profile.schema.json",
  "title": "Rusty Hostess media profile selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "profile_id", "owner", "owner_schema", "receipt_schema", "binding_schema",
    "platform_adapter", "product_binding", "authority", "receipt_expectations",
    "required_observations"
  ],
  "properties": {
    "$schema": { "const": "rusty.hostess.project_runner.media_profile.v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "owner": { "const": "rusty.manifold" },
    "owner_schema": { "const": "rusty.manifold.media.session_descriptor.v1" },
    "receipt_schema": { "const": "rusty.manifold.broker.adapter_receipt.v1" },
    "binding_schema": { "const": "rusty.hostess.project_runner.media_receipt_binding.v1" },
    "platform_adapter": { "const": "rusty.quest" },
    "product_binding": { "$ref": "#/$defs/binding" },
    "authority": { "$ref": "#/$defs/authority" },
    "receipt_expectations": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["standalone", "embedded"] } }
    },
    "required_observations": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_revision", "max_age_seconds"],
      "properties": {
        "minimum_revision": { "type": "integer", "minimum": 1 },
        "max_age_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "project_id", "project_revision", "project_spec_sha256", "product_id",
        "product_lock_id", "product_lock_revision", "product_lock_fingerprint",
        "product_lock_sha256"
      ],
      "properties": {
        "project_id": { "$ref": "#/$defs/id" },
        "project_revision": { "type": "integer", "minimum": 1 },
        "project_spec_sha256": { "$ref": "#/$defs/sha" },
        "product_id": { "$ref": "#/$defs/id" },
        "product_lock_id": { "$ref": "#/$defs/id" },
        "product_lock_revision": { "type": "integer", "minimum": 1 },
        "product_lock_fingerprint": { "type": "string", "pattern": "^fnv1a64-[0-9a-f]{16}$" },
        "product_lock_sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
